# PayShield SMS relay (scripts/sms-relay.mjs). Copy to .env and fill in. .env is git-ignored: never commit it.
# Which SMS service sends the real scam SMS: fast2sms (default, Indian numbers) or twilio.
SMS_PROVIDER=fast2sms

# --- Fast2SMS --- fast2sms.com > Dev API > copy the API key. Quick SMS is charged per text from your wallet.
FAST2SMS_API_KEY=

# --- Twilio (only if SMS_PROVIDER=twilio) --- Twilio console > Account info. The auth token is a secret.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX

# Who gets the scam SMS, in +91XXXXXXXXXX form. (On a Twilio trial it must be a verified number.)
SMS_TO_u_aarav=+91XXXXXXXXXX
# SMS_TO_c_anaya=+91XXXXXXXXXX
# 0 = dry run (logs what it would send, sends nothing). 1 = really send.
SMS_LIVE=0
# Hard limits so no balance or allowance is wasted.
SMS_DAILY_CAP=5
SMS_MIN_GAP_SEC=20
# Must match the room shown on the phones' "Live sync" badge.
ROOM=vslash-vk26
