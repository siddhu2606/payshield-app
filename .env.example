# PayShield SMS relay (scripts/sms-relay.mjs). Copy to .env and fill in. .env is git-ignored: never commit it.
# Twilio console > Account info. The auth token is a secret: paste it only here.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# Your Twilio phone number (Twilio console > Phone Numbers > Active numbers), in +E.164 form.
TWILIO_FROM=+1XXXXXXXXXX
# Who gets the scam SMS. On a trial account this must be a number you verified in Twilio.
SMS_TO_u_aarav=+91XXXXXXXXXX
# SMS_TO_c_anaya=+91XXXXXXXXXX
# 0 = dry run (logs what it would send, sends nothing). 1 = really send.
SMS_LIVE=0
# Hard limits so the trial allowance isn't wasted.
SMS_DAILY_CAP=5
SMS_MIN_GAP_SEC=20
# Must match the room shown on the phones' "Live sync" badge.
ROOM=vslash-vk26
